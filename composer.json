{
  "name": "amir-adventours/amir-booking",
  "description": "Sistema de reservas y gestión de tours para Amir Adventours Bacalar",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "tecnickcom/tcpdf": "^6.7",
    "endroid/qr-code": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "AmirBooking\\": "includes/"
    }
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "install-prod": [
      "composer install --no-dev --optimize-autoloader"
    ]
  },
  "extra": {
    "wordpress-install-dir": "."
  }
}
