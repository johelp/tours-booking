# Dependencias — se instalan en el build/despliegue con `composer install`
/vendor/

# node_modules en cualquier profundidad (raíz y react-src/) — se instalan con
# `npm install`, nunca se versionan
node_modules/

# Artefactos de SO / editor
.DS_Store
Thumbs.db
*.log

# Caché de PHPUnit
.phpunit.result.cache

# Configuración/estado local de Claude Code — carpeta completa, no archivos
# puntuales. Hallazgo de auditoría de seguridad, 2026-09-24:
# .claude/settings.local.json ya estuvo commiteado en el pasado (después
# removido) precisamente porque solo ESE archivo estaba ignorado, no el
# resto de .claude/ (ej. .claude/launch.json, worktrees/ con su propio .git
# anidado). Auditoría de hardening 2026-11-05 (SEC-007): se generaliza a
# toda la carpeta para que un archivo nuevo de esta carpeta nunca vuelva a
# colarse por el mismo motivo.
.claude/

# Archivos temporales de trabajo — nunca deben terminar en un ZIP de
# distribución (hallazgo de auditoría de seguridad, 2026-09-24: se filtraba
# vacía al ZIP porque los scripts de build no la excluían del rsync).
/scratch/

# Artefactos de build de los 3 ZIPs de edición (build-editions-*.sh) — se
# regeneran cada vez, nunca se versionan (ver CLAUDE.md § reglas críticas).
/.build-stage/
/dist-zips/

# Caché de Python de tools/
__pycache__/
